{
    "name": "abdullahdheir/laravel-blog-mcp",
    "description": "A stateless MCP (Model Context Protocol) server for Laravel with ready-made blog tools: let Claude list, draft, edit, schedule and publish your posts.",
    "keywords": ["laravel", "mcp", "model-context-protocol", "claude", "ai", "blog", "cms"],
    "type": "library",
    "license": "MIT",
    "authors": [
        { "name": "Abdullah Dheir", "homepage": "https://abdullahdheir.dev" }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/http": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/validation": "^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "AbdullahDheir\\BlogMcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AbdullahDheir\\BlogMcp\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AbdullahDheir\\BlogMcp\\BlogMcpServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
